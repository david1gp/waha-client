{
  "name": "@adaptive-ds/waha-client",
  "version": "0.6.0",
  "description": "TypeScript client and CLI for the WAHA (WhatsApp HTTP API). Full API coverage, Result-typed, Valibot-validated.",
  "keywords": [
    "waha",
    "whatsapp",
    "api-client",
    "typescript",
    "cli",
    "valibot",
    "result"
  ],
  "homepage": "https://github.com/david1gp/waha-client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david1gp/waha-client.git"
  },
  "bugs": {
    "url": "https://github.com/david1gp/waha-client/issues"
  },
  "license": "MIT",
  "type": "module",
  "private": false,
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "waha-client": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "test:w": "bun test --watch",
    "build": "rm -rf ./dist && tsc -p ./tsconfig.lib.json",
    "tsc": "tsc --noEmit",
    "release": "bash ./ops/release.sh",
    "update": "bun update",
    "update:commit": "bun update && git add package.json && bun run tsc && git commit -m \"chore(deps): update dependencies\" && git push",
    "format": "biome format --write src test package.json tsconfig.json tsconfig.lib.json biome.json",
    "clean": "rm -rf ./dist",
    "reset": "rm -rf ./node_modules"
  },
  "dependencies": {
    "@stricli/core": "^1.2.5"
  },
  "peerDependencies": {
    "@adaptive-ds/result": ">=0.4.0",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "^1.3.13",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "trailingComma": "all"
  },
  "imports": {
    "#result": "@adaptive-ds/result"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./apiKeys/*.js": {
      "types": "./dist/apiKeys/*.d.ts",
      "import": "./dist/apiKeys/*.js"
    },
    "./apps/*.js": {
      "types": "./dist/apps/*.d.ts",
      "import": "./dist/apps/*.js"
    },
    "./auth/*.js": {
      "types": "./dist/auth/*.d.ts",
      "import": "./dist/auth/*.js"
    },
    "./calls/*.js": {
      "types": "./dist/calls/*.d.ts",
      "import": "./dist/calls/*.js"
    },
    "./channels/*.js": {
      "types": "./dist/channels/*.d.ts",
      "import": "./dist/channels/*.js"
    },
    "./chats/*.js": {
      "types": "./dist/chats/*.d.ts",
      "import": "./dist/chats/*.js"
    },
    "./client/*.js": {
      "types": "./dist/client/*.d.ts",
      "import": "./dist/client/*.js"
    },
    "./contacts/*.js": {
      "types": "./dist/contacts/*.d.ts",
      "import": "./dist/contacts/*.js"
    },
    "./events/*.js": {
      "types": "./dist/events/*.d.ts",
      "import": "./dist/events/*.js"
    },
    "./groups/*.js": {
      "types": "./dist/groups/*.d.ts",
      "import": "./dist/groups/*.js"
    },
    "./labels/*.js": {
      "types": "./dist/labels/*.d.ts",
      "import": "./dist/labels/*.js"
    },
    "./lids/*.js": {
      "types": "./dist/lids/*.d.ts",
      "import": "./dist/lids/*.js"
    },
    "./media/*.js": {
      "types": "./dist/media/*.d.ts",
      "import": "./dist/media/*.js"
    },
    "./messages/*.js": {
      "types": "./dist/messages/*.d.ts",
      "import": "./dist/messages/*.js"
    },
    "./presence/*.js": {
      "types": "./dist/presence/*.d.ts",
      "import": "./dist/presence/*.js"
    },
    "./profile/*.js": {
      "types": "./dist/profile/*.d.ts",
      "import": "./dist/profile/*.js"
    },
    "./server/*.js": {
      "types": "./dist/server/*.d.ts",
      "import": "./dist/server/*.js"
    },
    "./sessions/*.js": {
      "types": "./dist/sessions/*.d.ts",
      "import": "./dist/sessions/*.js"
    },
    "./status/*.js": {
      "types": "./dist/status/*.d.ts",
      "import": "./dist/status/*.js"
    }
  },
  "files": [
    "dist"
  ]
}
